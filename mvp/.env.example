# 이 파일을 mvp/.env로 복사합니다. 키는 코드·GitHub·채팅창에 넣지 마세요.
# local: 이 PC 계정 로그인. staff: Supabase 직원 로그인, 설정이 없으면 접근 차단.
GUIDE_MODE=staff

# 모든 모드에서 원본·검색 데이터는 사용자 세션 대신 서버에 보관합니다.
# 비우면 프로젝트의 data/library. 서버의 별도 영구 디스크 절대 경로도 가능합니다.
GUIDE_DATA_DIR=
# local / supabase. supabase는 GUIDE_MODE=staff와 storage_schema.sql 설치가 필요합니다.
GUIDE_STORAGE_BACKEND=local
GUIDE_STORAGE_BUCKET=guide-originals

# 직원 모드에서 사용합니다. Supabase 프로젝트 URL + publishable/anon 키.
GUIDE_SUPABASE_URL=
GUIDE_SUPABASE_PUBLISHABLE_KEY=

# disabled / internal / groq_free 중 선택합니다. 유료 API 자동 전환은 없습니다.
GUIDE_LLM_PROVIDER=disabled
# internal: 병원이 승인하고 기존 비용으로 사용할 수 있는 Chat Completions 호환 서버
# 예: https://병원-AI-주소/v1 (뒤에 /chat/completions를 붙이지 않습니다)
GUIDE_LLM_BASE_URL=
GUIDE_LLM_API_KEY=
GUIDE_LLM_MODEL=
# 해당 서버로 원문을 전송할 수 있고, 실제 업무 용도가 허용됨을 관리자가 확인한 뒤 true.
GUIDE_LLM_APPROVED=false

# Groq 시험용: 무료 계정임을 확인한 경우에만 true. 유료 계정 여부를 코드가 확인하지는 못합니다.
# GUIDE_LLM_PROVIDER=groq_free, GUIDE_LLM_MODEL=openai/gpt-oss-20b
# 원내 임상 업무 연결 전 공급자의 이용 조건과 자료 처리 승인이 필요합니다.
GUIDE_GROQ_FREE_CONFIRMED=false

# 앱 전체 / 사용자별 최근 24시간 AI 요청 제한. 실패한 요청도 포함합니다.
GUIDE_DAILY_LLM_LIMIT=40
GUIDE_USER_DAILY_LLM_LIMIT=10
# 검색 유사도는 정답 확률이 아닙니다. 실제 지침 질문 평가로 조정합니다.
GUIDE_MIN_SIMILARITY=0.38
# 스캔 PDF: Tesseract와 kor/eng 언어 데이터 설치 후 true로 설정합니다. 외부 API는 쓰지 않습니다.
GUIDE_OCR_ENABLED=false
